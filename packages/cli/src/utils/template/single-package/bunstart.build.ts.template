/**
 * Build script: compiles TypeScript and emits declaration files.
 * Uses @bunstart/pack for unified build configuration.
 */
import { buildSetting } from '@bunstart/pack';

export async function build(): Promise<void> {
  console.log('Building...');

  const { build: packBuild } = buildSetting({
    entrypoints: ['{{ENTRYPOINT}}'],
    outdir: 'dist',
    target: 'bun',
    format: 'esm',
    minify: false,
    sourcemap: false
  });

  await packBuild();

  console.log('Build completed');
}

const isMain = process.argv[1]?.endsWith('bunstart.build.ts') || process.argv[1]?.endsWith('bunstart.build.js');
if (isMain) {
  build().catch((e) => {
    console.error('Build failed', e);
    process.exit(1);
  });
}
